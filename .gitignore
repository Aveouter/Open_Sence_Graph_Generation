outputs/pretrained/**/*.pth
outputs/pretrained/**/*.pt
outputs/pretrained/**/*.ckpt
outputs/pretrained/**/*.tar
outputs/pretrained/**/*.tar.gz
outputs/pretrained/**/*.zip
